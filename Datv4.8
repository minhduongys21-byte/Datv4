    Instance.new("UIListLayout", page).Padding = UDim.new(0, 8)

    tabPages[name] = {btn = tabBtn, page = page, indicator = activeIndicator}
    tabBtn.Activated:Connect(function() selectTab(name) end)
    return page
end

