-- HỆ THỐNG XỬ LÝ CHÍNH
--==================================================

function stopFly()
    if bv then bv:Destroy(); bv = nil end
    if bg then bg:Destroy(); bg = nil end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end
    holdPosition = nil
end

function startFly()
    stopFly()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if root and hum then
        hum.PlatformStand = true
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Velocity = Vector3.zero
        bv.Parent = root

        bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.P = 9000
        bg.CFrame = root.CFrame
        bg.Parent = root
        holdPosition = root.Position
    end
end

-- Vòng ngắm FOV
local fovCircle = nil
pcall(function()
    fovCircle = Drawing.new("Circle")
    fovCircle.Visible = false
    fovCircle.Thickness = 1.5
    fovCircle.NumSides = 60
    fovCircle.Filled = false
    fovCircle.Transparency = 0.8
    fovCircle.Color = Color3.fromRGB(0, 170, 255)
end)

local function isTeammate(targetPlayer)
    if not Config.TeamCheck then return false end
    return player.Team and targetPlayer.Team and player.Team == targetPlayer.Team
end

local function getAimTarget()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local cam = workspace.CurrentCamera
    if not root or not cam then return nil end

    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local bestTargetHead = nil
    local bestDist = Config.FOV

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player and not isTeammate(targetPlayer) then
            local tChar = targetPlayer.Character
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
            local tHead = tChar and tChar:FindFirstChild(Config.TargetPart)
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")

            if tHum and tHum.Health > 0 and tHead and tRoot then
                local worldDist = (root.Position - tRoot.Position).Magnitude
                if worldDist <= Config.MaxDistance then
                    local screenPos, visible = cam:WorldToViewportPoint(tHead.Position)
                    if visible and screenPos.Z > 0 then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if dist < bestDist then
                            if Config.WallCheck then
                                local params = RaycastParams.new()
                                params.FilterType = Enum.RaycastFilterType.Exclude
                                params.FilterDescendantsInstances = {char}
                                local ray = workspace:Raycast(cam.CFrame.Position, tHead.Position - cam.CFrame.Position, params)
                                if ray and ray.Instance:IsDescendantOf(tChar) then
                                    bestDist = dist
                                    bestTargetHead = tHead
                                end
                            else
                                bestDist = dist
                                bestTargetHead = tHead
                            end
                        end
                    end
                end
            end
        end
    end

    if fovCircle then
        fovCircle.Visible = Config.EnableFOV and Config.AimAssist
        fovCircle.Radius = Config.FOV
        fovCircle.Position = center
    end

    return bestTargetHead
end

local function getClosestEnemyRoot()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local closestRoot = nil
    local shortestDistance = Config.MaxDistance

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player and not isTeammate(targetPlayer) then
            local tChar = targetPlayer.Character
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")

            if tHum and tHum.Health > 0 and tRoot then
                local dist = (root.Position - tRoot.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    closestRoot = tRoot
                end
            end
        end
    end

    return closestRoot
end

-- ==================================================
-- [ĐOẠN RIÊNG] HỆ THỐNG XỬ LÝ SÚNG: KHÔNG NẠP ĐẠN, TỐC BẮN & NO RECOIL
-- ==================================================
local function handleGunAndAmmo()
    local char = player.Character
    if not char then return end

    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end

    -- 1. BẮN KHÔNG NẠP ĐẠN (VÔ HẠN ĐẠN)
    if Config.InfiniteAmmo then
        for _, obj in ipairs(tool:GetDescendants()) do
            if obj:IsA("ValueBase") then
                local name = obj.Name:lower()
                if name:find("ammo") or name:find("clip") or name:find("bullet") or name:find("mag") then
                    if obj:IsA("IntValue") or obj:IsA("NumberValue") then
                        obj.Value = 999
                    end
                end
            end
        end
        -- Xóa bỏ trạng thái Reloading trên Tool nếu có Attribute
        for attrName, _ in pairs(tool:GetAttributes()) do
            local lowerAttr = attrName:lower()
            if lowerAttr:find("reload") then
                pcall(function() tool:SetAttribute(attrName, false) end)
            elseif lowerAttr:find("ammo") or lowerAttr:find("clip") then
                pcall(function() tool:SetAttribute(attrName, 999) end)
            end
        end
    end

    -- 2. TỐC ĐỘ BẮN NHANH (RAPID FIRE)
    if Config.RapidFire then
        -- Giảm thời gian hồi/delay giữa các lần bắn trong Module Script
        for _, obj in ipairs(tool:GetDescendants()) do
            if obj:IsA("ValueBase") then
                local name = obj.Name:lower()
                if name:find("cooldown") or name:find("firedelay") or name:find("firerate") or name:find("delay") then
                    if obj:IsA("NumberValue") or obj:IsA("IntValue") then
                        obj.Value = 0.01 / Config.FireRateValue
                    end
                end
            elseif obj:IsA("ModuleScript") then
                pcall(function()
                    local configModule = require(obj)
                    if type(configModule) == "table" then
                        for k, v in pairs(configModule) do
                            local keyName = tostring(k):lower()
                            if keyName:find("firerate") or keyName:find("cooldown") or keyName:find("shootdelay") then
                                configModule[k] = 0.01 / Config.FireRateValue
                            end
                        end
                    end
                end)
            end
        end

        -- Tự xả đạn cực nhanh khi đang nhấn giữ chuột
        if isMouseDown then
            local currentTime = tick()
            local interval = math.clamp(0.1 / Config.FireRateValue, 0.01, 0.2)
            if currentTime - lastShotTime >= interval then
                lastShotTime = currentTime
                pcall(function() tool:Activate() end)
            end
        end
    end

    -- 3. BẮN KHÔNG GIẬT SÚNG / KHÓA NẢY CAMERA
    if Config.NoRecoil then
        local cam = workspace.CurrentCamera
        if isMouseDown and cam and not Config.AimAssist then
            local deltaMouse = UserInputService:GetMouseDelta()
            if deltaMouse.Magnitude < 2 then
                if lastCamCFrame then cam.CFrame = lastCamCFrame else lastCamCFrame = cam.CFrame end
            else
                lastCamCFrame = cam.CFrame
            end
        else
            lastCamCFrame = nil
        end

        for _, obj in ipairs(tool:GetDescendants()) do
            if obj:IsA("ValueBase") then
                local name = obj.Name:lower()
                if name:find("recoil") or name:find("spread") or name:find("kick") or name:find("shake") or name:find("bloom") then
                    if obj:IsA("Vector3Value") then obj.Value = Vector3.zero
                    elseif obj:IsA("CFrameValue") then obj.Value = CFrame.new()
                    else obj.Value = 0 end
                end
            end
        end
    end
end

-- Vòng lặp Render chính
RunService.RenderStepped:Connect(function(deltaTime)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local cam = workspace.CurrentCamera

    -- 1. Tốc độ chạy
    if hum and not Config.Fly then
        hum.WalkSpeed = Config.Speed and Config.SpeedValue or 16
    end

    -- 2. Tàng hình
    if char and Config.Invisibility then
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                v.Transparency = 1
            elseif v:IsA("Decal") then
                v.Transparency = 1
            elseif v:IsA("Accessory") then
                local handle = v:FindFirstChild("Handle")
                if handle then handle.Transparency = 1 end
            end
        end
    end

    -- 3. Fly theo Camera
    if Config.Fly and root and hum and cam then
        if not bv or not bv.Parent then startFly() end
        hum.PlatformStand = true
        bg.CFrame = cam.CFrame

        local speed = Config.FlyValue or 50
        local moveDir = hum.MoveDirection

        if moveDir.Magnitude > 0 then
            local rawMove = (cam.CFrame.LookVector * (-cam.CFrame:VectorToObjectSpace(moveDir).Z)) + (cam.CFrame.RightVector * (cam.CFrame:VectorToObjectSpace(moveDir).X))
            bv.Velocity = rawMove * speed
            holdPosition = root.Position
        else
            bv.Velocity = Vector3.zero
            if holdPosition then root.CFrame = CFrame.new(holdPosition, holdPosition + cam.CFrame.LookVector) end
        end
    else
        if bv then stopFly() end
    end

    -- 4. Xử lý Chức năng Súng & Đạn (Không nạp đạn / Tốc bắn / Không giật)
    handleGunAndAmmo()

    -- 5. Xử lý Teleport Đứng Im An Toàn
    if Config.TeleportToTarget and char and root then
        local enemyRoot = getClosestEnemyRoot()
        if enemyRoot then
            local targetPos = enemyRoot.CFrame * CFrame.new(0, 0.5, 3)
            char:PivotTo(targetPos)
            
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end

    -- 6. Xử lý Aim Assist & Auto Shoot
    if cam and Config.AimAssist then
        local targetHead = getAimTarget()
        if targetHead then
            local desiredCFrame = CFrame.lookAt(cam.CFrame.Position, targetHead.Position)
            local factor = math.clamp((Config.AimStrength / 100) * (deltaTime * 30), 0.01, 1)
            cam.CFrame = cam.CFrame:Lerp(desiredCFrame, factor)
        end
    elseif fovCircle and not Config.AimAssist then
        fovCircle.Visible = false
    end

    if Config.AutoShoot and char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then pcall(function() tool:Activate() end) end
        pcall(function()
            VirtualUser:Button1Down(Vector2.zero)
            task.delay(0.05, function() VirtualUser:Button1Up(Vector2.zero) end)
        end)
    end

    -- 7. Hitbox & ESP
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then
            local tChar = targetPlayer.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
            local tHead = tChar and tChar:FindFirstChild("Head")

            -- Hitbox Expander
            if tRoot then
                if Config.ExpandHitbox and not isTeammate(targetPlayer) then
                    tRoot.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                    tRoot.Transparency = Config.HitboxTransparency
                    tRoot.Color = Color3.fromRGB(255, 0, 0)
                    tRoot.CanCollide = false
                else
                    tRoot.Size = Vector3.new(2, 2, 1)
                    tRoot.Transparency = 1
                end
            end

            -- Highlight Viền ESP
            if tChar then
                local highlight = tChar:FindFirstChild("HUB_ESP")
                if Config.ESP then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "HUB_ESP"
                        highlight.Adornee = tChar
                        highlight.FillTransparency = 0.7
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.Parent = tChar
                    end
                    highlight.Enabled = true
                    highlight.OutlineColor = isTeammate(targetPlayer) and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
                elseif highlight then
                    highlight.Enabled = false
                end
            end

            -- Tag Tên & Máu
            if tHead and tHum then
                local billboard = tHead:FindFirstChild("HUB_ESP_Tag")
                if Config.ESPName or Config.ESPHealth then
                    if not billboard then
                        billboard = Instance.new("BillboardGui")
                        billboard.Name = "HUB_ESP_Tag"
                        billboard.Adornee = tHead
                        billboard.Size = UDim2.new(0, 200, 0, 50)
                        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                        billboard.AlwaysOnTop = true

                        local label = Instance.new("TextLabel")
                        label.Name = "Text"
                        label.Size = UDim2.new(1, 0, 1, 0)
                        label.BackgroundTransparency = 1
                        label.TextSize = 13
                        label.Font = Enum.Font.GothamBold
                        label.TextStrokeTransparency = 0.2
                        label.Parent = billboard
                        billboard.Parent = tHead
                    end

                    local label = billboard:FindFirstChild("Text")
                    if label then
                        local textDisplay = ""
                        if Config.ESPName then textDisplay = targetPlayer.Name end
                        if Config.ESPHealth then
                            local hp = math.floor(tHum.Health)
                            local maxHp = math.floor(tHum.MaxHealth)
                            if textDisplay ~= "" then
                                textDisplay = textDisplay .. " | HP: " .. tostring(hp) .. "/" .. tostring(maxHp)
                            else
                                textDisplay = "HP: " .. tostring(hp) .. "/" .. tostring(maxHp)
                            end
                        end
                        label.Text = textDisplay
                        label.TextColor3 = isTeammate(targetPlayer) and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(255, 60, 60)
                    end
                    billboard.Enabled = true
                elseif billboard then
                    billboard.Enabled = false
                end
            end
        end
    end
end)

player.CharacterAdded:Connect(function(newChar)
    stopFly()
    task.wait(0.5)
    local hum = newChar:WaitForChild("Humanoid", 3)
    if hum then hum.WalkSpeed = 16 end
end)

